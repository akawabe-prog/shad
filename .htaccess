# =========================================================
# SHAD JAPAN — .htaccess（本番: https://www.shad-japan.com/）
# ※ 本番（Drive → GCS ブランドサイト）ではこのファイルは使用されません。
#    バッチが .html を外して配置するため、クリーンURLはサーバー側で実現されます。
#    Apacheで配信する場合のみ有効な設定です。
# =========================================================
<IfModule mod_rewrite.c>
RewriteEngine On

# /bags /locks のページは別名ファイル（bags-lineup.html / shad-locks.html）で持つ。
# 同名の bags.html / locks.html があると、Apache の MultiViews が /bags/〜 /locks/〜（旧サイトの URL）を
# そのファイルに結び付けてしまい、下の旧 URL 転送が効かず 404 になるため
RewriteRule ^bags$ /bags-lineup.html [L]
RewriteRule ^locks$ /shad-locks.html [L]
RewriteCond %{THE_REQUEST} \s/+bags-lineup(\.html)?[\s?]
RewriteRule ^ /bags [R=301,L]
RewriteCond %{THE_REQUEST} \s/+shad-locks(\.html)?[\s?]
RewriteRule ^ /locks [R=301,L]

# 非www → www（本番は https://www.shad-japan.com/ が正規URL）
RewriteCond %{HTTP_HOST} ^shad-japan\.com$ [NC]
RewriteRule ^ https://www.shad-japan.com%{REQUEST_URI} [R=301,L]
# 本番ドメインは常時 https（さくらの無料SSL有効化後に効く。初期ドメインでの確認時は動かない）
RewriteCond %{HTTP_HOST} ^www\.shad-japan\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.shad-japan.com%{REQUEST_URI} [R=301,L]

# 非公開にした商品ページ（2026-08-17）。404にせず一覧へ逃がす
RewriteRule ^product/(sl18|sw80)/?$ /products [R=301,L,NC]

# 旧URL（フラット構成）→ 新URL（階層構成）
RewriteRule ^for-your-motorcycle/?$ /fitment [R=301,L,NC]
RewriteRule ^tokushoho(\.html)?/?$ /company [R=301,L,NC]   # 特商法ページは廃止（2026-09-30）→ 会社情報へ
RewriteRule ^product-([A-Za-z0-9]+)\.html/?$ /product/$1 [R=301,L,NC]
RewriteRule ^product-([A-Za-z0-9]+)/?$ /product/$1 [R=301,L,NC]

# /news はディレクトリなので index.html を明示（DirectoryIndex 未設定サーバー対策）
RewriteRule ^news/?$ /news/index.html [L]

# まだ静的ページを生成していない新着記事（/news/cj-<id>）は、APIから本文を表示するライブ記事ページへ
RewriteCond %{DOCUMENT_ROOT}/news/cj-$1.html !-f
RewriteRule ^news/cj-(\d+)/?$ /news/article.html?id=$1 [L,QSA]

# ===== 車種別ページ /bike/<車種> の URL 変更（マスターで車種名・年式が変わったもの）→ 新 URL へ 301（2026-10-16）
RewriteCond %{REQUEST_URI} ^/bike/honda-x-adv-21-25(\.html)?/?$ [NC]
RewriteRule ^ /bike/honda-x-adv-21-26 [R=301,L]
RewriteCond %{REQUEST_URI} ^/bike/suzuki-125-2026-6e9337(\.html)?/?$ [NC]
RewriteRule ^ /bike/suzuki-125-2026-ed295c [R=301,L]

# ===== 旧サイト（WordPress）URL → 新サイト：Google に登録済みの旧 URL を 301 で引き継ぐ（2026-10-13）
# ・%{REQUEST_URI}（実際にリクエストされた URL）で判定する。bags.html / locks.html があると Apache が /bags/〜 を
#   先にそのファイルへ結び付けてしまい、通常の RewriteRule のパターンでは照合できないため
# ・サーバー上の cases/ bags/ などのフォルダに頼らない。商品ページの品番一覧は products.json から生成
RewriteCond %{REQUEST_URI} ^/cases/top-cases/sh40-cargo/?$ [NC]
RewriteRule ^ /product/sh40cg [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/side-cases/sh38x-(carbon|aluminium)/?$ [NC]
RewriteRule ^ /product/sh38x [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/terra/tr55(b|-pure-black)/?$ [NC]
RewriteRule ^ /product/tr55 [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/terra/tr48b/?$ [NC]
RewriteRule ^ /product/tr48 [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/terra/tr37b/?$ [NC]
RewriteRule ^ /product/tr37 [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/click-system-bags/(e091cl|e09cl-pro)/?$ [NC]
RewriteRule ^ /product/e09cl [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/click-system-bags/e03cl-pro/?$ [NC]
RewriteRule ^ /product/e03cl [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/click-system-bags/(tr15c|tr15cl)/?$ [NC]
RewriteRule ^ /product/tr15cl [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/click-system-bags/tr10cl/?$ [NC]
RewriteRule ^ /product/tr10 [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/side-bags/e48-\d+/?$ [NC]
RewriteRule ^ /product/e48 [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/cafe-racer-bags/sr38(-[a-z]+)?/?$ [NC]
RewriteRule ^ /product/sr38 [R=301,L]
RewriteCond %{REQUEST_URI} ^/(?:cases|bags|locks)/[^/]+/(tr15cl|sh40cg|sh58x|sh59x|e48sr|sh38x|e03cl|e09cl|e09cm|sh33|sc25|sh23|sh48|sr38|seat|sh35|sh36|sh34|tr48|tr37|tr36|tr47|ib20|sh47|sl58|lock|sh44|tr40|tr55|tr50|e03c|e09c|e02c|tr10|tr30|tr41|tr46|sh51|tr27|tr08|sh26|sh29|sh39|sh40|sh45|e04|e48)(?:-[a-z0-9-]+)?/?$ [NC]
RewriteRule ^ /product/%1 [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/?$ [NC]
RewriteRule ^ /products [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/top-cases/?$ [NC]
RewriteRule ^ /top-cases [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/side-cases/?$ [NC]
RewriteRule ^ /side-cases [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/(terra|terra-side-cases|terra-top-cases)/?$ [NC]
RewriteRule ^ /terra [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/side-bags/?$ [NC]
RewriteRule ^ /side-bags [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/click-system-bags/?$ [NC]
RewriteRule ^ /tank-bags [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/(terra-bags|adventure-bags)/?$ [NC]
RewriteRule ^ /terra [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/cafe-racer-bags/?$ [NC]
RewriteRule ^ /side-bags [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/$ [NC]
RewriteRule ^ /bags [R=301,L]
RewriteCond %{REQUEST_URI} ^/bags/.+$ [NC]
RewriteRule ^ /bags [R=301,L]
RewriteCond %{REQUEST_URI} ^/cases/.+$ [NC]
RewriteRule ^ /products [R=301,L]
RewriteCond %{REQUEST_URI} ^/locks/.*$ [NC]
RewriteRule ^ /locks [R=301,L]
RewriteCond %{REQUEST_URI} ^/shad_base/?$ [NC]
RewriteRule ^ /store-locator [R=301,L]
RewriteCond %{REQUEST_URI} ^/wp-content/uploads/.*catalog_2024.*\.pdf$ [NC]
RewriteRule ^ /docs/catalog/shad_catalog_2024.pdf [R=301,L]
RewriteCond %{REQUEST_URI} ^/wp-content/uploads/.*2025.*catalog.*\.pdf$ [NC]
RewriteRule ^ /docs/catalog/shad_catalog_2025.pdf [R=301,L]
RewriteCond %{REQUEST_URI} ^/wp-content/uploads/.*catalog.*\.pdf$ [NC]
RewriteRule ^ /docs/catalog/shad_catalog_2026.pdf [R=301,L]
RewriteCond %{REQUEST_URI} ^/wp-content/.*$ [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{REQUEST_URI} ^/\d{4}-\d{2}-\d{2}-(news|media)\d+/?$ [NC]
RewriteRule ^ /news [R=301,L]
RewriteCond %{REQUEST_URI} ^/(category|tag)/.*$ [NC]
RewriteRule ^ /news [R=301,L]
RewriteCond %{REQUEST_URI} ^/\d{4}/\d{2}(/.*)?$ [NC]
RewriteRule ^ /news [R=301,L]
# ===== /旧サイト URL

# .html つきのアクセスは拡張子なしへ 301
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 拡張子なしのリクエストを .html に内部マッピング
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]
</IfModule>

# テキスト系は gzip 圧縮して配信（HTML・CSS・JS・JSON・SVG・XML。本番で未圧縮だったため 2026-10-01 追加）
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType application/json "access plus 1 hours"
</IfModule>

# 404 ページ
ErrorDocument 404 /404.html
