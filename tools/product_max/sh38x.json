  "stories": [
    {
      "img": "/img/products/sh38x/story_expand.webp",
      "kick": "Expandable",
      "h": "走るときはスリム。停まれば、大容量。",
      "p": "レバー操作で数秒。走行時は車幅を抑えてスリムに、停車後はモジュラーヘルメットが収まる容量へ。建築の概念「テンセグリティ」に着想を得た張力補償システムで、均一にテレスコピック展開する。容量が変わるサイドケースは、世界でSHADだけ。"
    },
    {
      "img": "/img/products/sh38x/story_mount.webp",
      "kick": "3P / 4P System",
      "h": "車体に、溶け込むマウント。",
      "p": "必要なアンカーを1本のアームで支える特許構造。マスを車体中心に集め、走行中のハンドリングへの影響を最小化。可変機構はケースと取付部に完全内蔵され、ケースを外しても美しいシルエットのまま。"
    },
    {
      "img": "/img/products/sh38x/story_lock.webp",
      "kick": "Premium Smart Lock",
      "h": "鍵いらずの、ワンタッチ。",
      "p": "解錠状態にしておけば、ボタン操作だけで開閉。料金所での小銭、休憩時の出し入れ。ひとつの鍵で開ける・閉める・外すが完結し、格納式ハンドルで持ち運びも楽に。"
    }
  ],
