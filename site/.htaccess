# =========================================================
# SHAD JAPAN — .htaccess（本番: https://www.shad-japan.com/）
# ※ 本番（Drive → GCS ブランドサイト）ではこのファイルは使用されません。
#    バッチが .html を外して配置するため、クリーンURLはサーバー側で実現されます。
#    Apacheで配信する場合のみ有効な設定です。
# =========================================================
<IfModule mod_rewrite.c>
RewriteEngine On

# /bags：サーバー上に旧 bags/ ディレクトリが残っていても bags.html を返す（他のルールより先に評価）
RewriteRule ^bags/?$ /bags.html [L]

# 非www → www（本番は https://www.shad-japan.com/ が正規URL）
RewriteCond %{HTTP_HOST} ^shad-japan\.com$ [NC]
RewriteRule ^ https://www.shad-japan.com%{REQUEST_URI} [R=301,L]
# 本番ドメインは常時 https（さくらの無料SSL有効化後に効く。初期ドメインでの確認時は動かない）
RewriteCond %{HTTP_HOST} ^www\.shad-japan\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.shad-japan.com%{REQUEST_URI} [R=301,L]

# 非公開にした商品ページ（2026-08-17）。404にせず一覧へ逃がす
RewriteRule ^product/(sl18|sw80)/?$ /products [R=301,L,NC]

# 旧URL（フラット構成）→ 新URL（階層構成）
RewriteRule ^for-your-motorcycle/?$ /fitment [R=301,L,NC]
RewriteRule ^tokushoho(\.html)?/?$ /company [R=301,L,NC]   # 特商法ページは廃止（2026-09-30）→ 会社情報へ
RewriteRule ^product-([A-Za-z0-9]+)\.html/?$ /product/$1 [R=301,L,NC]
RewriteRule ^product-([A-Za-z0-9]+)/?$ /product/$1 [R=301,L,NC]

# /news はディレクトリなので index.html を明示（DirectoryIndex 未設定サーバー対策）
RewriteRule ^news/?$ /news/index.html [L]

# まだ静的ページを生成していない新着記事（/news/cj-<id>）は、APIから本文を表示するライブ記事ページへ
RewriteCond %{DOCUMENT_ROOT}/news/cj-$1.html !-f
RewriteRule ^news/cj-(\d+)/?$ /news/article.html?id=$1 [L,QSA]

# ===== 旧サイト（WordPress）URL → 新サイト：Google に登録済みの旧 URL を 301 で引き継ぐ（2026-10-13）
# サーバー上の cases/ bags/ などのフォルダに頼らず、ここで一括管理する（フォルダを消しても転送が切れないように）
# --- 個別の読み替え（品番の表記ゆれ・統合）
RewriteRule ^cases/top-cases/sh40-cargo/?$ /product/sh40cg [R=301,L,NC]
RewriteRule ^cases/side-cases/sh38x-(carbon|aluminium)/?$ /product/sh38x [R=301,L,NC]
RewriteRule ^cases/terra/tr55(b|-pure-black)/?$ /product/tr55 [R=301,L,NC]
RewriteRule ^cases/terra/tr48b/?$ /product/tr48 [R=301,L,NC]
RewriteRule ^cases/terra/tr37b/?$ /product/tr37 [R=301,L,NC]
RewriteRule ^bags/click-system-bags/(e091cl|e09cl-pro)/?$ /product/e09cl [R=301,L,NC]
RewriteRule ^bags/click-system-bags/e03cl-pro/?$ /product/e03cl [R=301,L,NC]
RewriteRule ^bags/click-system-bags/(tr15c|tr15cl)/?$ /product/tr15cl [R=301,L,NC]
RewriteRule ^bags/click-system-bags/tr10cl/?$ /product/tr10 [R=301,L,NC]
RewriteRule ^bags/side-bags/e48-\d+/?$ /product/e48 [R=301,L,NC]
RewriteRule ^bags/cafe-racer-bags/sr38(-[a-z]+)?/?$ /product/sr38 [R=301,L,NC]
# --- 商品ページ：/cases/〇〇/sh23/ や /bags/〇〇/tr30/ → /product/sh23（新サイトにページがあるものだけ）
RewriteCond %{DOCUMENT_ROOT}/product/$1.html -f
RewriteRule ^(?:cases|bags|locks)/[^/]+/([a-z]+\d+[a-z]*)(?:-[a-z0-9-]+)?/?$ /product/$1 [R=301,L,NC]
# --- カテゴリ
RewriteRule ^cases/?$ /products [R=301,L,NC]
RewriteRule ^cases/top-cases/?$ /top-cases [R=301,L,NC]
RewriteRule ^cases/side-cases/?$ /side-cases [R=301,L,NC]
RewriteRule ^cases/(terra|terra-side-cases|terra-top-cases)/?$ /terra [R=301,L,NC]
RewriteRule ^bags/side-bags/?$ /side-bags [R=301,L,NC]
RewriteRule ^bags/click-system-bags/?$ /tank-bags [R=301,L,NC]
RewriteRule ^bags/(terra-bags|adventure-bags)/?$ /terra [R=301,L,NC]
RewriteRule ^bags/cafe-racer-bags/?$ /side-bags [R=301,L,NC]
RewriteRule ^bags/.+$ /bags [R=301,L,NC]
RewriteRule ^cases/.+$ /products [R=301,L,NC]
RewriteRule ^locks(/.*)?$ /locks [R=301,L,NC]
RewriteRule ^shad_base/?$ /store-locator [R=301,L,NC]
# --- 旧カタログ PDF → 新サイトのカタログ
RewriteRule ^wp-content/uploads/.*catalog_2024.*\.pdf$ /docs/catalog/shad_catalog_2024.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/.*2025.*catalog.*\.pdf$ /docs/catalog/shad_catalog_2025.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/.*catalog.*\.pdf$ /docs/catalog/shad_catalog_2026.pdf [R=301,L,NC]
RewriteRule ^wp-content/.*$ / [R=301,L,NC]
# --- 旧ニュース（/2024-10-17-news3693/ /category/news/ /2025/10 など）→ NEWS 一覧
RewriteRule ^\d{4}-\d{2}-\d{2}-(news|media)\d+/?$ /news [R=301,L,NC]
RewriteRule ^(category|tag)/.*$ /news [R=301,L,NC]
RewriteRule ^\d{4}/\d{2}(/.*)?$ /news [R=301,L,NC]
# ===== /旧サイト URL

# .html つきのアクセスは拡張子なしへ 301
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 拡張子なしのリクエストを .html に内部マッピング
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]
</IfModule>

# テキスト系は gzip 圧縮して配信（HTML・CSS・JS・JSON・SVG・XML。本番で未圧縮だったため 2026-10-01 追加）
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType application/json "access plus 1 hours"
</IfModule>

# 404 ページ
ErrorDocument 404 /404.html
