# ============================================================
# SHAD JAPAN (shad.customjapan.net) — Apache .htaccess
# クリーンURL対応（eXs / exs.customjapan.net と同方式）
#  必要: mod_rewrite / AllowOverride FileInfo (または All)
# ============================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.shad\.customjapan\.net$ [NC]
RewriteRule ^ https://shad.customjapan.net%{REQUEST_URI} [R=301,L]

RewriteRule ^index/?$ / [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html/?$ / [R=301,L,NC]

# 直接 .html アクセスはクリーンURLへ 301
RewriteCond %{THE_REQUEST} \s/+about\.html(?:[\s?]|$) [NC]
RewriteRule ^about\.html/?$ /about [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/+awards\.html(?:[\s?]|$) [NC]
RewriteRule ^awards\.html/?$ /awards [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/+company\.html(?:[\s?]|$) [NC]
RewriteRule ^company\.html/?$ /company [R=301,L,NC]
